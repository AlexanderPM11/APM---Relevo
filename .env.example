# Runtime
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
TZ=UTC
# Optional public API origin shown in the connection guide behind a proxy.
API_PUBLIC_BASE_URL=

# MySQL (local Compose defaults; change passwords before deployment)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=relevo
MYSQL_USER=relevo
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# Optional full SQLAlchemy URL; overrides the MYSQL_* values.
# DATABASE_URL=mysql+asyncmy://relevo:password@mysql:3306/relevo?charset=utf8mb4

# Security: generate unique random values before deploying.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
API_KEY_PEPPER=replace-with-another-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Router
ROUTER_MAX_ATTEMPTS=3
ROUTER_REQUEST_TIMEOUT_SECONDS=60
ROUTER_COOLDOWN_DEFAULT_SECONDS=60
ROUTER_CIRCUIT_FAILURE_THRESHOLD=3
ROUTER_STRATEGY=priority
LAYA_ROUTING_MODE=off
LAYA_BASE_URL=http://laya:8000
LAYA_CLASSIFIER_MODEL=multilingual
LAYA_TIMEOUT_SECONDS=2
LAYA_MIN_CONFIDENCE=0.55
ROUTER_FREE_ONLY=false
# Override with a random value of at least 32 characters when enabling Laya in production.
LAYA_API_KEY=development-laya-internal-key
LAYA_THREADS=2
ROUTER_ENABLE_LOCAL_FALLBACK=false
LOG_PROMPTS=false
DOCS_ENABLED=true
PROMETHEUS_ENABLED=false

# Optional provider credentials. A provider without its credential is disabled.
# Create keys only with providers you choose; never commit real keys.
GOOGLE_AI_STUDIO_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
COHERE_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
KILO_API_KEY=
HUGGINGFACE_API_KEY=
OLLAMA_BASE_URL=
