# Production routing profile. Keep provider/database/admin secrets in the deployment secret store.
# This profile uses the same internal Laya service defined in docker-compose.yml.
APP_ENV=production
ROUTER_STRATEGY=laya
LAYA_ROUTING_MODE=active
LAYA_BASE_URL=http://laya:8000
LAYA_CLASSIFIER_MODEL=multilingual
LAYA_TIMEOUT_SECONDS=2
LAYA_MIN_CONFIDENCE=0.55
ROUTER_FREE_ONLY=true
LAYA_API_KEY=replace-with-a-random-secret-at-least-32-characters
